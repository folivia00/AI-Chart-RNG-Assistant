# Assistant provider: rule_based | gemini | openai | ollama
# rule_based works offline and needs no API key.
LLM_PROVIDER=rule_based

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash when empty.
GEMINI_MODEL=

# OpenAI (planned)
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama (planned)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
